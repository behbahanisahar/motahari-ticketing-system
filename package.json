{
  "name": "ticketing-system",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build": "cd frontend && npm install && npm run build",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "lan:up": "docker compose -f docker-compose.yml -f docker-compose.lan.yml up --build -d",
    "lan:down": "docker compose -f docker-compose.yml -f docker-compose.lan.yml down"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "claude": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jalaali-js": "^1.2.7",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "serverless-http": "^3.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
